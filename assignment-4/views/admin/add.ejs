<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add Product – MFES Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>

<div class="admin-wrapper">
  <%- include('partials/sidebar', { page: 'add' }) %>

  <div class="admin-main">

    <header class="admin-topbar">
      <h4 class="mb-0"><i class="fa-solid fa-circle-plus me-2"></i>Add New Product</h4>
      <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Dashboard
      </a>
    </header>

    <div class="admin-content">

      <!-- Upload error (from multer middleware) -->
      <% if (typeof uploadError !== 'undefined' && uploadError) { %>
        <div class="alert alert-warning">
          <i class="fa-solid fa-triangle-exclamation me-2"></i><%= uploadError %>
        </div>
      <% } %>

      <!-- Validation errors -->
      <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger">
          <p class="fw-semibold mb-1"><i class="fa-solid fa-circle-xmark me-2"></i>Please fix the following:</p>
          <ul class="mb-0 ps-3">
            <% errors.forEach(e => { %><li><%= e %></li><% }); %>
          </ul>
        </div>
      <% } %>

      <div class="admin-card">
        <div class="admin-card-header">
          <h5 class="mb-0">Product Details</h5>
        </div>

        <form method="POST" action="/admin/products/add" enctype="multipart/form-data" class="p-4" novalidate>

          <div class="row g-4">

            <!-- Name -->
            <div class="col-12 col-md-6">
              <label class="form-label required-label">Product Name</label>
              <input
                type="text" name="name" class="form-control"
                placeholder="e.g. Jinko 550W Mono Panel"
                value="<%= old.name || '' %>" required
              />
            </div>

            <!-- Category -->
            <div class="col-12 col-md-6">
              <label class="form-label required-label">Category</label>
              <select name="category" class="form-select" required>
                <option value="">— Select Category —</option>
                <% categories.forEach(function(cat) { %>
                  <option value="<%= cat %>" <%= (old.category === cat) ? 'selected' : '' %>>
                    <%= cat %>
                  </option>
                <% }); %>
              </select>
            </div>

            <!-- Price -->
            <div class="col-12 col-md-4">
              <label class="form-label required-label">Price (PKR)</label>
              <div class="input-group">
                <span class="input-group-text">PKR</span>
                <input
                  type="number" name="price" class="form-control"
                  placeholder="0" min="0" step="1"
                  value="<%= old.price || '' %>" required
                />
              </div>
            </div>

            <!-- Rating -->
            <div class="col-12 col-md-4">
              <label class="form-label required-label">Rating (1–5)</label>
              <select name="rating" class="form-select" required>
                <option value="">— Select —</option>
                <% [1,2,3,4,5].forEach(function(r) { %>
                  <option value="<%= r %>" <%= (old.rating == r) ? 'selected' : '' %>>
                    <%= r %> ★
                  </option>
                <% }); %>
              </select>
            </div>

            <!-- Stock -->
            <div class="col-12 col-md-4">
              <label class="form-label required-label">Stock Quantity</label>
              <input
                type="number" name="stock" class="form-control"
                placeholder="0" min="0" step="1"
                value="<%= old.stock || '' %>" required
              />
            </div>

            <!-- Description -->
            <div class="col-12">
              <label class="form-label">Description <span class="text-muted small">(optional)</span></label>
              <textarea name="description" class="form-control" rows="3"
                placeholder="Short product description..."><%= old.description || '' %></textarea>
            </div>

            <!-- Image upload -->
            <div class="col-12">
              <label class="form-label">Product Image <span class="text-muted small">(JPEG / PNG / WEBP, max 5 MB)</span></label>
              <div class="upload-area" id="uploadArea">
                <i class="fa-solid fa-cloud-arrow-up fa-2x text-muted mb-2"></i>
                <p class="mb-0 text-muted">Click to browse or drag &amp; drop an image</p>
                <p class="small text-muted mt-1" id="fileNameLabel">No file chosen</p>
                <input type="file" name="image" id="imageInput" accept="image/jpeg,image/png,image/webp,image/gif" class="upload-input" />
              </div>
              <!-- Image preview -->
              <div id="imagePreviewWrap" class="mt-2 d-none">
                <img id="imagePreview" src="" alt="Preview" class="img-preview" />
                <button type="button" id="clearImage" class="btn btn-sm btn-outline-danger ms-2">
                  <i class="fa-solid fa-xmark me-1"></i>Remove
                </button>
              </div>
            </div>

          </div><!-- /row -->

          <hr class="my-4" />

          <div class="d-flex gap-2 justify-content-end">
            <a href="/admin/dashboard" class="btn btn-outline-secondary px-4">Cancel</a>
            <button type="submit" class="btn btn-add-top px-5">
              <i class="fa-solid fa-plus me-1"></i>Add Product
            </button>
          </div>

        </form>
      </div>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Image upload preview
  const input = document.getElementById("imageInput");
  const preview = document.getElementById("imagePreview");
  const previewWrap = document.getElementById("imagePreviewWrap");
  const fileLabel = document.getElementById("fileNameLabel");
  const clearBtn = document.getElementById("clearImage");
  const uploadArea = document.getElementById("uploadArea");

  uploadArea.addEventListener("click", () => input.click());

  uploadArea.addEventListener("dragover", (e) => {
    e.preventDefault();
    uploadArea.classList.add("drag-over");
  });
  uploadArea.addEventListener("dragleave", () => uploadArea.classList.remove("drag-over"));
  uploadArea.addEventListener("drop", (e) => {
    e.preventDefault();
    uploadArea.classList.remove("drag-over");
    if (e.dataTransfer.files[0]) {
      input.files = e.dataTransfer.files;
      showPreview(e.dataTransfer.files[0]);
    }
  });

  input.addEventListener("change", () => {
    if (input.files[0]) showPreview(input.files[0]);
  });

  function showPreview(file) {
    fileLabel.textContent = file.name;
    preview.src = URL.createObjectURL(file);
    previewWrap.classList.remove("d-none");
  }

  clearBtn.addEventListener("click", () => {
    input.value = "";
    preview.src = "";
    fileLabel.textContent = "No file chosen";
    previewWrap.classList.add("d-none");
  });
</script>
</body>
</html>
