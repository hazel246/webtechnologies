<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/products">
      <i class="fa-solid fa-solar-panel me-2"></i>MFES Solar
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link" href="/products">
            <i class="fa-solid fa-store me-1"></i>Products
          </a>
        </li>
        <% if (currentUser) { %>
          <li class="nav-item">
            <a class="nav-link" href="/checkout">
              <i class="fa-solid fa-cart-shopping me-1"></i>Checkout
            </a>
          </li>
          <% if (currentUser.role === 'admin') { %>
            <li class="nav-item">
              <a class="nav-link text-warning" href="/admin/dashboard">
                <i class="fa-solid fa-shield-halved me-1"></i>Admin Panel
              </a>
            </li>
          <% } %>
        <% } %>
      </ul>

      <ul class="navbar-nav ms-auto align-items-center gap-1">
        <% if (currentUser) { %>
          <!-- Logged-in user -->
          <li class="nav-item">
            <span class="nav-link text-light pe-none">
              <i class="fa-solid fa-circle-user me-1"></i>
              <strong><%= currentUser.name %></strong>
              <% if (currentUser.role === 'admin') { %>
                <span class="badge bg-warning text-dark ms-1" style="font-size:0.65rem;">ADMIN</span>
              <% } %>
            </span>
          </li>
          <li class="nav-item">
            <form method="POST" action="/auth/logout" class="d-inline">
              <button type="submit" class="btn btn-outline-light btn-sm">
