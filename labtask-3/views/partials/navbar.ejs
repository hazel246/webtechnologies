              </button>
            </form>
          </li>
        <% } else { %>
          <!-- Guest -->
          <li class="nav-item">
            <a class="nav-link" href="/auth/login">
              <i class="fa-solid fa-right-to-bracket me-1"></i>Login
            </a>
          </li>
          <li class="nav-item">
            <a class="btn btn-warning btn-sm fw-semibold" href="/auth/register">
              <i class="fa-solid fa-user-plus me-1"></i>Register
