<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login – MFES Solar</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/auth.css" />
</head>
<body class="auth-body">

  <div class="auth-card">

    <!-- Brand -->
    <div class="auth-brand">
      <i class="fa-solid fa-solar-panel fa-2x text-warning mb-2"></i>
      <h2 class="fw-bold mb-0">MFES Solar</h2>
      <p class="text-muted small mb-0">Sign in to your account</p>
    </div>

    <!-- Logout flash (passed via query after session destroy) -->
    <% if (typeof query !== 'undefined' && query.loggedOut) { %>
      <div class="alert alert-success mb-3">
        <i class="fa-solid fa-circle-check me-2"></i>
        You have successfully logged out<% if (query.name) { %>, <%= query.name %><% } %>!
      </div>
    <% } %>

    <!-- Flash messages -->
    <%- include('../partials/flash') %>

    <!-- Validation errors -->
    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger">
        <% errors.forEach(e => { %><div><i class="fa-solid fa-circle-xmark me-2"></i><%= e %></div><% }); %>
      </div>
    <% } %>

    <form method="POST" action="/auth/login" novalidate>

      <div class="mb-3">
        <label class="form-label fw-semibold">Email Address</label>
        <div class="input-group">
          <span class="input-group-text"><i class="fa-solid fa-envelope text-muted"></i></span>
          <input type="email" name="email" class="form-control"
            placeholder="you@example.com" autocomplete="email" required />
        </div>
      </div>

      <div class="mb-4">
        <label class="form-label fw-semibold">Password</label>
        <div class="input-group">
          <span class="input-group-text"><i class="fa-solid fa-lock text-muted"></i></span>
          <input type="password" name="password" id="passwordField" class="form-control"
            placeholder="••••••••" autocomplete="current-password" required />
          <button type="button" class="input-group-text bg-white" id="togglePwd" tabindex="-1">
            <i class="fa-solid fa-eye text-muted" id="eyeIcon"></i>
          </button>
        </div>
      </div>

      <button type="submit" class="btn btn-auth w-100 mb-3">
        <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In
      </button>

    </form>

    <p class="text-center text-muted small">
      Don't have an account?
      <a href="/auth/register" class="fw-semibold text-warning">Create one</a>
    </p>

    <!-- Demo credentials hint -->
    <div class="demo-hint mt-3">
      <p class="fw-semibold mb-1 small"><i class="fa-solid fa-key me-1"></i>Demo Credentials</p>
      <div class="d-flex gap-3 flex-wrap">
        <div>
          <span class="badge bg-danger me-1">Admin</span>
          <code class="small">admin@mfes.com / admin123</code>
        </div>
        <div>
          <span class="badge bg-secondary me-1">Customer</span>
          <code class="small">ali@example.com / customer123</code>
        </div>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.getElementById("togglePwd").addEventListener("click", function () {
      const field = document.getElementById("passwordField");
      const icon = document.getElementById("eyeIcon");
      if (field.type === "password") {
        field.type = "text";
        icon.className = "fa-solid fa-eye-slash text-muted";
      } else {
        field.type = "password";
        icon.className = "fa-solid fa-eye text-muted";
      }
    });
  </script>
</body>
</html>
