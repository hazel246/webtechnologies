<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard – MFES Solar</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
<div class="admin-wrapper">
  <%- include('partials/sidebar', { page: 'dashboard' }) %>

  <div class="admin-main">
    <header class="admin-topbar">
      <h4 class="mb-0"><i class="fa-solid fa-gauge-high me-2"></i>Dashboard</h4>
      <a href="/admin/products/add" class="btn btn-add-top">
        <i class="fa-solid fa-plus me-1"></i>Add Product
      </a>
    </header>

    <div class="admin-content">

      <!-- Flash messages -->
      <% if (success && success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show flash-alert">
          <i class="fa-solid fa-circle-check me-2"></i><%= success[0] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>
      <% if (error && error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show flash-alert">
          <i class="fa-solid fa-circle-xmark me-2"></i><%= error[0] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <!-- Stat cards -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
          <div class="stat-card">
            <div class="stat-icon bg-primary-soft"><i class="fa-solid fa-box fa-lg text-primary"></i></div>
            <div><p class="stat-label">Total Products</p><h3 class="stat-value"><%= totalProducts %></h3></div>
          </div>
        </div>
        <div class="col-6 col-xl-3">
          <div class="stat-card">
            <div class="stat-icon bg-success-soft"><i class="fa-solid fa-cubes fa-lg text-success"></i></div>
            <div><p class="stat-label">Total Stock</p><h3 class="stat-value"><%= totalStock.toLocaleString() %></h3></div>
          </div>
        </div>
        <div class="col-6 col-xl-3">
          <div class="stat-card">
            <div class="stat-icon bg-warning-soft"><i class="fa-solid fa-triangle-exclamation fa-lg text-warning"></i></div>
            <div><p class="stat-label">Low Stock</p><h3 class="stat-value"><%= lowStock %></h3></div>
          </div>
        </div>
        <div class="col-6 col-xl-3">
          <div class="stat-card">
            <div class="stat-icon bg-danger-soft"><i class="fa-solid fa-circle-xmark fa-lg text-danger"></i></div>
            <div><p class="stat-label">Out of Stock</p><h3 class="stat-value"><%= outOfStock %></h3></div>
          </div>
        </div>
      </div>

      <!-- Products table -->
      <div class="admin-card">
        <div class="admin-card-header">
          <h5 class="mb-0"><i class="fa-solid fa-table me-2"></i>All Products</h5>
          <span class="badge bg-secondary"><%= totalProducts %> total</span>
        </div>

        <% if (products.length === 0) { %>
          <div class="text-center py-5 text-muted">
            <i class="fa-solid fa-box-open fa-3x mb-3"></i>
            <p>No products yet. <a href="/admin/products/add">Add the first one.</a></p>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table admin-table">
              <thead>
                <tr>
                  <th>#</th><th>Image</th><th>Name</th><th>Category</th>
                  <th>Price (PKR)</th><th>Rating</th><th>Stock</th>
                  <th class="text-center">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% products.forEach((product, i) => { %>
                  <tr>
                    <td class="text-muted small"><%= i + 1 %></td>
                    <td>
                      <% if (product.image) { %>
                        <img src="<%= product.image %>" alt="" class="product-thumb" />
                      <% } else { %>
                        <div class="product-thumb-placeholder"><i class="fa-solid fa-image text-muted"></i></div>
                      <% } %>
                    </td>
                    <td class="fw-semibold"><%= product.name %></td>
                    <td><span class="cat-pill"><%= product.category %></span></td>
                    <td><%= product.price.toLocaleString() %></td>
                    <td>
                      <span class="stars">
                        <% for (let s = 1; s <= 5; s++) { %>
                          <i class="fa-star fa-xs <%= s <= product.rating ? 'fa-solid text-warning' : 'fa-regular text-muted' %>"></i>
                        <% } %>
                      </span>
                    </td>
                    <td>
                      <span class="stock-pill <%= product.stock > 10 ? 'in' : product.stock > 0 ? 'low' : 'out' %>">
                        <%= product.stock %>
                      </span>
                    </td>
                    <td class="text-center">
                      <a href="/admin/products/edit/<%= product._id %>" class="btn btn-sm btn-edit me-1">
                        <i class="fa-solid fa-pen-to-square me-1"></i>Edit
                      </a>
                      <button class="btn btn-sm btn-delete"
                        data-bs-toggle="modal" data-bs-target="#deleteModal"
                        data-id="<%= product._id %>" data-name="<%= product.name %>">
                        <i class="fa-solid fa-trash me-1"></i>Delete
                      </button>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

    </div>
  </div>
</div>

<!-- Delete confirmation modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title"><i class="fa-solid fa-trash me-2"></i>Confirm Deletion</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body py-4 text-center">
        <i class="fa-solid fa-circle-exclamation fa-3x text-danger mb-3"></i>
        <p class="mb-1">You are about to permanently delete:</p>
        <p class="fw-bold fs-5 text-dark" id="deleteProductName">—</p>
        <p class="text-muted small">This action cannot be undone.</p>
      </div>
      <div class="modal-footer justify-content-center gap-2">
        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
          <i class="fa-solid fa-xmark me-1"></i>Cancel
        </button>
        <form id="deleteForm" method="POST" action="">
          <button type="submit" class="btn btn-danger px-4">
            <i class="fa-solid fa-trash me-1"></i>Yes, Delete
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  document.getElementById("deleteModal").addEventListener("show.bs.modal", function (e) {
    const btn = e.relatedTarget;
    document.getElementById("deleteProductName").textContent = btn.dataset.name;
    document.getElementById("deleteForm").action = "/admin/products/delete/" + btn.dataset.id;
  });
  setTimeout(() => {
    document.querySelectorAll(".flash-alert").forEach(el => bootstrap.Alert.getOrCreateInstance(el)?.close());
  }, 4000);
</script>
</body>
</html>
