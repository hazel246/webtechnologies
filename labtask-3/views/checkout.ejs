<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout – MFES Solar</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/products.css" />
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container my-5">
    <div class="text-center py-5">
      <i class="fa-solid fa-cart-shopping fa-4x text-warning mb-4"></i>
      <h2 class="fw-bold mb-2">Checkout</h2>
      <p class="text-muted mb-1">
        Welcome, <strong><%= currentUser.name %></strong>!
        You are authenticated and can access this protected page.
      </p>
      <p class="text-muted">Checkout functionality would be implemented here.</p>
      <a href="/products" class="btn btn-warning fw-semibold mt-3 px-4">
        <i class="fa-solid fa-arrow-left me-2"></i>Continue Shopping
      </a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
