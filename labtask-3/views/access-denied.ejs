<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Access Denied – MFES Solar</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/auth.css" />
</head>
<body class="auth-body">

  <div class="auth-card text-center">
    <div class="mb-3">
      <i class="fa-solid fa-shield-halved fa-4x text-danger"></i>
    </div>
    <h2 class="fw-bold text-danger mb-2">Access Denied</h2>
    <p class="text-muted mb-1">
      You do not have permission to access the Admin Panel.
    </p>
    <% if (currentUser) { %>
      <p class="text-muted small mb-4">
        You are signed in as <strong><%= currentUser.name %></strong>
        with the role <span class="badge bg-secondary"><%= currentUser.role %></span>.
        Admin privileges are required.
      </p>
    <% } %>
    <a href="/products" class="btn btn-warning fw-semibold px-4">
      <i class="fa-solid fa-arrow-left me-2"></i>Back to Store
    </a>
  </div>

</body>
</html>
