<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login – MFES Solar Energy</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700;800&family=Lato:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .btn-logout { background: none; border: none; cursor: pointer; color: inherit; font-family: inherit; font-size: inherit; }
    .nav-register-btn { background: #FDB913; color: #003399 !important; padding: 6px 16px; border-radius: 4px; font-weight: 700; }
    body { background: #f0f4ff; }
    .auth-section { min-height: calc(100vh - 200px); display: flex; align-items: center; padding: 60px 0; }
    .auth-card { background: white; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,51,153,0.12); overflow: hidden; }
    .auth-card-header { background: linear-gradient(135deg, #003399 0%, #0055cc 100%); padding: 40px; color: white; text-align: center; }
    .auth-card-header .logo-img { width: 100px; margin-bottom: 15px; }
    .auth-card-body { padding: 40px; }
    .demo-box { background: #f0f4ff; border: 1px dashed #003399; border-radius: 10px; padding: 16px; margin-bottom: 24px; font-size: 13px; }
    .demo-box strong { color: #003399; }
    .demo-credentials { font-family: monospace; background: white; border-radius: 6px; padding: 8px 12px; margin-top: 8px; font-size: 12px; }
    .btn-login { background: linear-gradient(135deg, #003399 0%, #0055cc 100%); color: white; border: none; border-radius: 8px; padding: 12px; font-weight: 700; font-size: 16px; transition: all 0.3s; }
    .btn-login:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,51,153,0.3); color: white; }
    .form-control { border-radius: 8px; padding: 12px 16px; border: 2px solid #e0e7ff; transition: border-color 0.3s; }
    .form-control:focus { border-color: #003399; box-shadow: 0 0 0 3px rgba(0,51,153,0.1); }
    .auth-link { color: #003399; font-weight: 600; text-decoration: none; }
    .auth-link:hover { color: #FDB913; }
  </style>
</head>
<body>

<%- include('../partials/navbar') %>

<section class="auth-section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="auth-card">
          <div class="auth-card-header">
            <img src="/images/mfesl.png" alt="MFES Solar Energy" class="logo-img">
            <h3 class="fw-bold mb-1">Welcome Back</h3>
            <p class="mb-0 opacity-75">Sign in to your MFES account</p>
          </div>
          <div class="auth-card-body">

            <!-- Demo Credentials -->
            <div class="demo-box">
              <div class="d-flex align-items-center mb-2">
                <i class="fas fa-info-circle text-primary me-2"></i>
                <strong>Demo Credentials</strong>
              </div>
              <div class="demo-credentials">
                <div><i class="fas fa-user-shield text-warning me-2"></i><strong>Admin:</strong> admin@mfes.com / admin123</div>
                <div class="mt-1"><i class="fas fa-user text-primary me-2"></i><strong>Customer:</strong> ali@example.com / customer123</div>
              </div>
            </div>

            <form action="/auth/login" method="POST">
              <div class="mb-3">
                <label for="email" class="form-label fw-semibold">Email Address</label>
                <div class="input-group">
                  <span class="input-group-text bg-light"><i class="fas fa-envelope text-muted"></i></span>
                  <input type="email" name="email" id="email" class="form-control" placeholder="your@email.com" required>
                </div>
              </div>
              <div class="mb-4">
                <label for="password" class="form-label fw-semibold">Password</label>
                <div class="input-group">
                  <span class="input-group-text bg-light"><i class="fas fa-lock text-muted"></i></span>
                  <input type="password" name="password" id="password" class="form-control" placeholder="Enter your password" required>
                </div>
              </div>
              <button type="submit" class="btn btn-login w-100 mb-3">
                <i class="fas fa-sign-in-alt me-2"></i>Login
              </button>
            </form>

            <div class="text-center">
              <p class="mb-0 text-muted">Don't have an account? <a href="/auth/register" class="auth-link">Register here</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
</body>
</html>
