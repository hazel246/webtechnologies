<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — MFES Solar' : 'MFES Solar Energy' %></title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <!-- Products CSS -->
  <link rel="stylesheet" href="/css/products.css" />
  <!-- jQuery loaded in <head> so it is available to all scripts in the page body -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <style>
    body { font-family: 'Lexend', sans-serif; background: #f1f5f9; }
    .site-navbar {
      background: #0f172a;
      padding: 14px 0;
    }
    .site-navbar .navbar-brand {
      color: #f59e0b;
      font-weight: 700;
      font-size: 1.3rem;
    }
    .site-navbar .nav-link {
      color: #cbd5e1 !important;
      font-weight: 500;
      margin: 0 6px;
      transition: color 0.2s;
    }
    .site-navbar .nav-link:hover,
    .site-navbar .nav-link.active { color: #f59e0b !important; }
    .site-footer {
      background: #0f172a;
      color: #94a3b8;
      text-align: center;
      padding: 20px;
      margin-top: 40px;
      font-size: 0.9rem;
    }
  </style>
</head>
<body>

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg site-navbar">
    <div class="container">
      <a class="navbar-brand" href="/">
        <i class="fa-solid fa-solar-panel me-2"></i>MFES Solar
      </a>
      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav ms-auto align-items-lg-center">
          <li class="nav-item"><a class="nav-link" href="/products">Products</a></li>
          <li class="nav-item">
            <a class="nav-link fw-bold" href="/onsale-products" style="color:#f59e0b !important;">
              <i class="fa-solid fa-tag me-1"></i>On Sale
            </a>
          </li>
          <% if (currentUser) { %>
            <% if (currentUser.role === 'admin') { %>
              <li class="nav-item"><a class="nav-link" href="/admin">Admin Panel</a></li>
            <% } %>
            <li class="nav-item"><a class="nav-link" href="/auth/logout">Logout (<%= currentUser.name %>)</a></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/auth/login">Login</a></li>
            <li class="nav-item"><a class="nav-link" href="/auth/register">Register</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <!-- FLASH MESSAGES -->
  <% if (typeof successFlash !== 'undefined' && successFlash && successFlash.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
      <%= successFlash[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (typeof errorFlash !== 'undefined' && errorFlash && errorFlash.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
      <%= errorFlash[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- PAGE CONTENT injected here -->
  <%- body %>

  <!-- FOOTER -->
  <footer class="site-footer">
    <p class="mb-0">&copy; 2026 MFES Solar Energy. All rights reserved.</p>
  </footer>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
