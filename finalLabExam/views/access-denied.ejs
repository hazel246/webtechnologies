<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Access Denied – MFES Solar Energy</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700;800&family=Lato:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .btn-logout { background: none; border: none; cursor: pointer; color: inherit; font-family: inherit; font-size: inherit; }
    .nav-register-btn { background: #FDB913; color: #003399 !important; padding: 6px 16px; border-radius: 4px; font-weight: 700; }
    .denied-section { min-height: calc(100vh - 200px); display: flex; align-items: center; padding: 80px 0; background: #fff5f5; }
    .denied-card { background: white; border-radius: 20px; box-shadow: 0 15px 50px rgba(220,38,38,0.1); padding: 60px; text-align: center; max-width: 600px; margin: 0 auto; border-top: 5px solid #dc2626; }
    .denied-icon { font-size: 80px; color: #dc2626; margin-bottom: 24px; }
    .error-code { font-size: 100px; font-weight: 800; color: #fecaca; line-height: 1; margin-bottom: 0; }
  </style>
</head>
<body>

<%- include('partials/navbar') %>

<section class="denied-section">
  <div class="container">
    <div class="denied-card">
      <p class="error-code">403</p>
      <div class="denied-icon">
        <i class="fas fa-lock"></i>
      </div>
      <h2 class="fw-bold mb-3" style="color: #dc2626;">Access Denied</h2>
      <p class="lead text-muted mb-3">
        Sorry, you don't have permission to access this page.
      </p>
      <% if (currentUser) { %>
        <div class="alert alert-warning d-inline-flex align-items-center gap-2 mb-4">
          <i class="fas fa-user-circle"></i>
          <span>Your account role is <strong>customer</strong>. Admin access is required for this page.</span>
        </div>
      <% } %>
      <p class="text-muted mb-5">
        The Admin Panel is restricted to administrators only. If you believe this is a mistake, please contact support.
      </p>
      <div class="d-flex gap-3 justify-content-center flex-wrap">
        <a href="/products" class="btn btn-primary btn-lg px-4">
          <i class="fas fa-store me-2"></i>Go to Products
        </a>
        <a href="/" class="btn btn-outline-secondary btn-lg px-4">
          <i class="fas fa-home me-2"></i>Home
        </a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
