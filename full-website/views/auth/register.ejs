<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register – MFES Solar Energy</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700;800&family=Lato:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .btn-logout { background: none; border: none; cursor: pointer; color: inherit; font-family: inherit; font-size: inherit; }
    .nav-register-btn { background: #FDB913; color: #003399 !important; padding: 6px 16px; border-radius: 4px; font-weight: 700; }
    body { background: #f0f4ff; }
    .auth-section { min-height: calc(100vh - 200px); display: flex; align-items: center; padding: 60px 0; }
    .auth-card { background: white; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,51,153,0.12); overflow: hidden; }
    .auth-card-header { background: linear-gradient(135deg, #003399 0%, #0055cc 100%); padding: 40px; color: white; text-align: center; }
    .auth-card-header .logo-img { width: 100px; margin-bottom: 15px; }
    .auth-card-body { padding: 40px; }
    .btn-register { background: linear-gradient(135deg, #FDB913 0%, #e5a600 100%); color: #003399; border: none; border-radius: 8px; padding: 12px; font-weight: 700; font-size: 16px; transition: all 0.3s; }
    .btn-register:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(253,185,19,0.4); color: #003399; }
    .form-control { border-radius: 8px; padding: 12px 16px; border: 2px solid #e0e7ff; transition: border-color 0.3s; }
    .form-control:focus { border-color: #003399; box-shadow: 0 0 0 3px rgba(0,51,153,0.1); }
    .auth-link { color: #003399; font-weight: 600; text-decoration: none; }
    .auth-link:hover { color: #FDB913; }
  </style>
</head>
<body>

<%- include('../partials/navbar') %>

<section class="auth-section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="auth-card">
          <div class="auth-card-header">
            <img src="/images/mfesl.png" alt="MFES Solar Energy" class="logo-img">
            <h3 class="fw-bold mb-1">Create Account</h3>
            <p class="mb-0 opacity-75">Join MFES Solar Energy today</p>
          </div>
          <div class="auth-card-body">

            <form action="/auth/register" method="POST">
              <div class="mb-3">
                <label for="name" class="form-label fw-semibold">Full Name</label>
                <div class="input-group">
                  <span class="input-group-text bg-light"><i class="fas fa-user text-muted"></i></span>
                  <input type="text" name="name" id="name" class="form-control" placeholder="Your full name" required>
                </div>
              </div>
              <div class="mb-3">
                <label for="email" class="form-label fw-semibold">Email Address</label>
                <div class="input-group">
                  <span class="input-group-text bg-light"><i class="fas fa-envelope text-muted"></i></span>
                  <input type="email" name="email" id="email" class="form-control" placeholder="your@email.com" required>
                </div>
              </div>
              <div class="mb-3">
                <label for="password" class="form-label fw-semibold">Password</label>
                <div class="input-group">
                  <span class="input-group-text bg-light"><i class="fas fa-lock text-muted"></i></span>
                  <input type="password" name="password" id="password" class="form-control" placeholder="Min 6 characters" required minlength="6">
                </div>
              </div>
              <div class="mb-4">
                <label for="confirmPassword" class="form-label fw-semibold">Confirm Password</label>
                <div class="input-group">
                  <span class="input-group-text bg-light"><i class="fas fa-lock text-muted"></i></span>
                  <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" placeholder="Repeat password" required>
                </div>
              </div>
              <button type="submit" class="btn btn-register w-100 mb-3">
                <i class="fas fa-user-plus me-2"></i>Create Account
              </button>
            </form>

            <div class="text-center">
              <p class="mb-0 text-muted">Already have an account? <a href="/auth/login" class="auth-link">Login here</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
</body>
</html>
