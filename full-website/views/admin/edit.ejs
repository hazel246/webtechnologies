<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Product – MFES Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css">
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <style>
    .btn-logout { background: none; border: none; cursor: pointer; color: inherit; font-family: inherit; font-size: inherit; }
    .nav-register-btn { background: #FDB913; color: #003399 !important; padding: 6px 16px; border-radius: 4px; font-weight: 700; }
  </style>
</head>
<body>

<%- include('../partials/navbar') %>

<div class="container-fluid py-4" style="background: #f1f5f9; min-height: 100vh;">
  <div class="container-xl">

    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-pen-to-square me-2 text-warning"></i>Edit Product</h4>
        <p class="text-muted mb-0 small">Update product details</p>
      </div>
      <a href="/admin" class="btn btn-outline-secondary btn-sm">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Dashboard
      </a>
    </div>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger">
        <p class="fw-semibold mb-1"><i class="fa-solid fa-circle-xmark me-2"></i>Please fix the following:</p>
        <ul class="mb-0 ps-3">
          <% errors.forEach(e => { %><li><%= e %></li><% }); %>
        </ul>
      </div>
    <% } %>

    <div class="admin-card">
      <div class="admin-card-header">
        <h5 class="mb-0">Editing: <span class="text-warning"><%= product.name %></span></h5>
        <span class="text-muted small">ID: <%= product._id %></span>
      </div>

      <form method="POST" action="/admin/edit/<%= product._id %>" enctype="multipart/form-data" class="p-4" novalidate>

        <div class="row g-4">

          <!-- Name -->
          <div class="col-12 col-md-6">
            <label class="form-label required-label">Product Name</label>
            <input type="text" name="name" class="form-control"
              value="<%= product.name %>" required />
          </div>

          <!-- Category -->
          <div class="col-12 col-md-6">
            <label class="form-label required-label">Category</label>
            <select name="category" class="form-select" required>
              <option value="">— Select Category —</option>
              <% CATEGORIES.forEach(function(cat) { %>
                <option value="<%= cat %>" <%= product.category === cat ? 'selected' : '' %>>
                  <%= cat %>
                </option>
              <% }); %>
            </select>
          </div>

          <!-- Price -->
          <div class="col-12 col-md-4">
            <label class="form-label required-label">Price (PKR)</label>
            <div class="input-group">
              <span class="input-group-text">PKR</span>
              <input type="number" name="price" class="form-control"
                value="<%= product.price %>" min="0" step="1" required />
            </div>
          </div>

          <!-- Rating -->
          <div class="col-12 col-md-4">
            <label class="form-label required-label">Rating (1–5)</label>
            <select name="rating" class="form-select" required>
              <% [1,2,3,4,5].forEach(function(r) { %>
                <option value="<%= r %>" <%= product.rating === r ? 'selected' : '' %>>
                  <%= r %> ★
                </option>
              <% }); %>
            </select>
          </div>

          <!-- Stock -->
          <div class="col-12 col-md-4">
            <label class="form-label required-label">Stock Quantity</label>
            <input type="number" name="stock" class="form-control"
              value="<%= product.stock %>" min="0" step="1" required />
          </div>

          <!-- Description -->
          <div class="col-12">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3"><%= product.description || '' %></textarea>
          </div>

          <!-- Image -->
          <div class="col-12">
            <label class="form-label">Product Image</label>

            <% if (product.image) { %>
              <div class="d-flex align-items-center gap-3 mb-3 p-3 bg-light rounded">
                <img src="<%= product.image %>" alt="Current image" class="img-preview" />
                <div>
                  <p class="mb-1 fw-semibold small">Current image</p>
                  <p class="mb-0 text-muted small"><%= product.image %></p>
                  <p class="mb-0 text-muted small mt-1">Upload a new image below to replace it.</p>
                </div>
              </div>
            <% } %>

            <div class="upload-area" id="uploadArea">
              <i class="fa-solid fa-cloud-arrow-up fa-2x text-muted mb-2"></i>
              <p class="mb-0 text-muted">
                <%= product.image ? 'Upload a new image to replace the current one' : 'Click to browse or drag & drop' %>
              </p>
              <p class="small text-muted mt-1" id="fileNameLabel">No file chosen</p>
              <input type="file" name="image" id="imageInput"
                accept="image/jpeg,image/png,image/webp,image/gif" class="upload-input" />
            </div>

            <div id="imagePreviewWrap" class="mt-2 d-none">
              <img id="imagePreview" src="" alt="New image preview" class="img-preview" />
              <button type="button" id="clearImage" class="btn btn-sm btn-outline-danger ms-2">
                <i class="fa-solid fa-xmark me-1"></i>Remove
              </button>
            </div>
          </div>

        </div>

        <hr class="my-4" />

        <div class="d-flex gap-2 justify-content-end">
          <a href="/admin" class="btn btn-outline-secondary px-4">Cancel</a>
          <button type="submit" class="btn btn-add-top px-5">
            <i class="fa-solid fa-floppy-disk me-1"></i>Save Changes
          </button>
        </div>

      </form>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
<script src="/js/main.js"></script>
<script>
  const input = document.getElementById("imageInput");
  const preview = document.getElementById("imagePreview");
  const previewWrap = document.getElementById("imagePreviewWrap");
  const fileLabel = document.getElementById("fileNameLabel");
  const clearBtn = document.getElementById("clearImage");
  const uploadArea = document.getElementById("uploadArea");

  uploadArea.addEventListener("click", () => input.click());
  uploadArea.addEventListener("dragover", (e) => { e.preventDefault(); uploadArea.classList.add("drag-over"); });
  uploadArea.addEventListener("dragleave", () => uploadArea.classList.remove("drag-over"));
  uploadArea.addEventListener("drop", (e) => {
    e.preventDefault();
    uploadArea.classList.remove("drag-over");
    if (e.dataTransfer.files[0]) { input.files = e.dataTransfer.files; showPreview(e.dataTransfer.files[0]); }
  });
  input.addEventListener("change", () => { if (input.files[0]) showPreview(input.files[0]); });

  function showPreview(file) {
    fileLabel.textContent = file.name;
    preview.src = URL.createObjectURL(file);
    previewWrap.classList.remove("d-none");
  }

  clearBtn.addEventListener("click", () => {
    input.value = "";
    preview.src = "";
    fileLabel.textContent = "No file chosen";
    previewWrap.classList.add("d-none");
  });
</script>
</body>
</html>
